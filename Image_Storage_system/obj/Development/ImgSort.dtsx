                  SQLTask:SqlStatementSource=" declare @num int = 1, @n int = 3, @r int =?&#xA;drop table if exists #num&#xA;create table #num(num int)&#xA;set @num=(@r-1)*5+1&#xA;while @num&gt;=(@r-1)*5+1 and @num&lt;=(@r-1)*5+5&#xA;begin&#xA;insert into #num&#xA;values(@num)&#xA;set @num = @num + 1&#xA;end&#xA; select * from #num"
