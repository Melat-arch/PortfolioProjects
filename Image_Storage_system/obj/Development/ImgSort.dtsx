                          SQLTask:SqlStatementSource="Declare @ImmageName Varchar(255)=?,@SummaryFileFolder Varchar(255)=?,@BatchFileFolder  Varchar(255)=?&#xA;Insert Into dbo.ImmageIndexing(SummaryID, DocType,DocDate,ImmageName)&#xA;Select SummaryID,&#xA;&#x9;&#x9;Left(Replace(@ImmageName,@SummaryFileFolder+'\', ''), CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))-1),&#xA;&#x9;&#x9;Convert(Date,Substring(Replace(@ImmageName,@SummaryFileFolder+'\', ''),CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))+1,&#xA;&#x9;&#x9;CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''),CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))+1)&#xA;&#x9;&#x9;-CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))-1),112),&#xA;&#x9;&#x9;Right(Replace(@ImmageName,@SummaryFileFolder+'\', ''),CharIndex('_', Reverse(Replace(@ImmageName,@SummaryFileFolder+'\', '')))-1)&#xA;From dbo.Summary&#xA;where SummaryFolderName=Replace(@SummaryFileFolder,@BatchFileFolder+'\', '')&#xA;Except&#xA;&#xA;Select SummaryID,&#xA;       DocType,&#xA;&#x9;   DocDate,&#xA;&#x9;   ImmageName&#xA;From dbo.ImmageIndexing" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
