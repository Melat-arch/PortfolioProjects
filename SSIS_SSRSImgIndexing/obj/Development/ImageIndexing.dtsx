                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{64B663C2-5C5C-4371-879F-194DB708571F}"
                          SQLTask:SqlStatementSource="Declare @ImmageName Varchar(255)=?,@SummaryFileFolder Varchar(255)=?,@BatchFileFolder  Varchar(255)=?&#xA;Insert Into dbo.ImmageIndexing(SummaryID, DocType,DocDate,ImmageName)&#xA;Select SummaryID,&#xA;  Left(Replace(@ImmageName,@SummaryFileFolder+'\', ''), CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))-1),&#xA;  Convert(Date,Substring(Replace(@ImmageName,@SummaryFileFolder+'\', ''),CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))+1,&#xA;  CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''),CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))+1)&#xA;  -CharIndex('_',Replace(@ImmageName,@SummaryFileFolder+'\', ''))-1),112),&#xA;  Right(Replace(@ImmageName,@SummaryFileFolder+'\', ''),CharIndex('_', Reverse(Replace(@ImmageName,@SummaryFileFolder+'\', '')))-1)&#xA;From dbo.Summary&#xA;where SummaryFolderName=Replace(@SummaryFileFolder,@BatchFileFolder+'\', '')&#xA;Except&#xA;&#xA;Select SummaryID,&#xA;       DocType,&#xA;    DocDate,&#xA;    ImmageName&#xA;From dbo.ImmageIndexing" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                          <SQLTask:ParameterBinding
                            SQLTask:ParameterName="@ImmageName"
                            SQLTask:DtsVariableName="User::ImmagFullyQualifiedName"
                            SQLTask:ParameterDirection="Input"
                            SQLTask:DataType="129"
                            SQLTask:ParameterSize="-1" />
