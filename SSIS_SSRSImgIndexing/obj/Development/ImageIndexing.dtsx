                  SQLTask:SqlStatementSource="&#xA;Declare @num Int, @n int=3, @R Int=?&#xA;Drop table if exists #num&#xA;Create table #num(num int)&#xA;Set @num=(@r-1)*5+1&#xA;While @num&gt;=(@r-1)*5+1 and @num&lt;= (@r-1)*5+5&#xA;Begin &#xA;Insert into #num&#xA;Values(@num)&#xA;Set @num=@num+1&#xA;End&#xA;&#xA;Select * from #Num"
